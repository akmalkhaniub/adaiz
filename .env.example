# AdAiz — Environment Configuration Template
# Copy to `.env` to enable live frontier LLM providers and cloud telemetry.
# Works out-of-the-box without keys via the Deterministic High-Fidelity Sandbox Engine.

# Optional Frontier LLM Providers (Dynamic Model Cascade Gateway)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Zero-Trust HMAC-SHA256 Signing Secret for Human-in-the-Loop (LIVE_SPEND) Approvals
ADAIZ_APPROVAL_HMAC_SECRET=adaiz-zero-trust-hmac-secret-key-2026

# Optional Observability & Distributed Tracing (Langfuse / LangSmith)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
